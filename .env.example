# Copy to .env and fill in the keys you have; leave the rest blank.
# The scrapers and the price check read .env automatically. Variables already set in
# your shell take priority over this file.

# --- Web search (first one set is used; DuckDuckGo needs no key) ---
SERPER_API_KEY=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Distributor APIs ---
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_SITE=US
# DIGIKEY_CURRENCY=USD
# Free-shipping minimums for your country (check the distributor's site):
# MOUSER_FREE_SHIP_MIN=
# DIGIKEY_FREE_SHIP_MIN=

# --- Price check (pricecheck/; same names as PERBot) ---
NOTION_TOKEN=
SLACK_BOT_TOKEN=
# PRICE_CHECK_THRESHOLD_PCT=10
# PRICE_CHECK_MIN_DELTA_USD=0
# PRICE_CHECK_CHANNEL=
# PRICE_CHECK_BATCH=10
# PRICE_CHECK_LOOKBACK_HOURS=168
# The listener (python -m pricecheck)
NOTION_WEBHOOK_SECRET=
# PRICE_LISTENER_SETTLE_SECONDS=60
# PRICE_LISTENER_MAX_PER_HOUR=20
# BENBUYS_SEASON=REV12

# --- LLM for llm_scraper and the price check (first one set is used; Ollama needs no key) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=
